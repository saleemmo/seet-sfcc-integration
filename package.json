{
  "name": "seet-sfcc-integration",
  "packageName": "int_seet",
  "version": "0.1.0",
  "description": "Seet Reviews & Ratings integration cartridge (int_seet) for Salesforce B2C Commerce Cloud SFRA",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "npm run compile:js && npm run compile:scss",
    "compile:js": "sgmf-scripts --compile js",
    "compile:scss": "sgmf-scripts --compile css",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "sgmf-scripts --lint js",
    "lint:css": "sgmf-scripts --lint css",
    "lint:fix": "sgmf-scripts --lint js --fix",
    "test": "sgmf-scripts --test \"tests/unit/**/*.test.js\"",
    "cover": "sgmf-scripts --cover tests/unit --include \"cartridges/**/*.js\" --exclude \"cartridges/**/static/**,cartridges/**/client/**\"",
    "test:integration": "sgmf-scripts --integration \"tests/integration/**/*.js\"",
    "validate:metadata": "node bin/validate-metadata.js",
    "package:metadata": "node bin/package-metadata.js",
    "upload": "sgmf-scripts --uploadCartridge int_seet",
    "watch": "sgmf-scripts --watch",
    "check": "npm run lint && npm run validate:metadata && npm test && npm run build"
  },
  "browserslist": [
    "last 2 versions",
    "not dead",
    "> 0.5%"
  ],
  "paths": {},
  "devDependencies": {
    "autoprefixer": "^10.7.0",
    "chai": "^4.5.0",
    "css-loader": "^7.1.5",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.33",
    "postcss-loader": "^8.2.2",
    "postcss-scss": "^4.0.9",
    "proxyquire": "^2.1.3",
    "sass": "^1.108.2",
    "sass-loader": "^16.0.8",
    "sfcc-schemas": "^2.0.0",
    "sgmf-scripts": "^4.0.0",
    "sinon": "^21.1.2",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "webpack": "^5.113.0",
    "webpack-remove-empty-scripts": "^1.1.1"
  }
}
