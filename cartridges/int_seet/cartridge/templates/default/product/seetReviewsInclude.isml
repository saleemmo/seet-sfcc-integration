<iscomment>
    Seet reviews section for the product page. Add to the merchant's PDP template
    (rendered by Product-Show), e.g. below the product description:
        <isinclude template="product/seetReviewsInclude" />
</iscomment>
<isif condition="${pdict.seet && pdict.seet.enabled}">
    <isscript>
        var assets = require('*/cartridge/scripts/assets');
        assets.addCss('/css/seetReviews.css');
        assets.addJs('/js/seetReviews.js');
    </isscript>
    <isinclude url="${pdict.seet.reviewsUrl}" />
</isif>
