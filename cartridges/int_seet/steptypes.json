{
    "step-types": {
        "script-module-step": [
            {
                "@type-id": "custom.Seet.ExportOrders",
                "@supports-parallel-execution": "false",
                "@supports-site-context": "true",
                "@supports-organization-context": "false",
                "description": "Sends PENDING Seet order outbox records to the Seet API.",
                "module": "int_seet/cartridge/scripts/jobs/ExportOrders.js",
                "function": "execute",
                "transactional": "false",
                "timeout-in-seconds": "1800",
                "parameters": {
                    "parameter": [
                        {
                            "@name": "BatchSize",
                            "@type": "long",
                            "@required": "false",
                            "@trim": "true",
                            "description": "Maximum number of outbox records processed per run.",
                            "default-value": "50",
                            "min-value": "1",
                            "max-value": "500"
                        },
                        {
                            "@name": "MaxRetries",
                            "@type": "long",
                            "@required": "false",
                            "@trim": "true",
                            "description": "Failed attempts after which a record is no longer retried automatically.",
                            "default-value": "8",
                            "min-value": "1",
                            "max-value": "50"
                        },
                        {
                            "@name": "BaseDelayMinutes",
                            "@type": "long",
                            "@required": "false",
                            "@trim": "true",
                            "description": "Initial retry delay in minutes; doubled after each failed attempt.",
                            "default-value": "5",
                            "min-value": "1",
                            "max-value": "1440"
                        },
                        {
                            "@name": "MaxDelayMinutes",
                            "@type": "long",
                            "@required": "false",
                            "@trim": "true",
                            "description": "Upper bound for the retry delay in minutes.",
                            "default-value": "720",
                            "min-value": "1",
                            "max-value": "10080"
                        }
                    ]
                },
                "status-codes": {
                    "status": [
                        {
                            "@code": "ERROR",
                            "description": "Unexpected error or export stopped early (configuration, authentication or availability)."
                        },
                        {
                            "@code": "ABORTED",
                            "description": "Export stopped early because of a configuration, authentication or availability error."
                        },
                        {
                            "@code": "DISABLED",
                            "description": "Seet order sync is disabled or not configured for the site."
                        },
                        {
                            "@code": "OK",
                            "description": "Step finished; the message contains batch statistics."
                        }
                    ]
                }
            },
            {
                "@type-id": "custom.Seet.RetryFailedOrders",
                "@supports-parallel-execution": "false",
                "@supports-site-context": "true",
                "@supports-organization-context": "false",
                "description": "Recovers stale records and retries FAILED Seet order outbox records using exponential backoff.",
                "module": "int_seet/cartridge/scripts/jobs/RetryFailedOrders.js",
                "function": "execute",
                "transactional": "false",
                "timeout-in-seconds": "1800",
                "parameters": {
                    "parameter": [
                        {
                            "@name": "BatchSize",
                            "@type": "long",
                            "@required": "false",
                            "@trim": "true",
                            "description": "Maximum number of outbox records processed per run.",
                            "default-value": "50",
                            "min-value": "1",
                            "max-value": "500"
                        },
                        {
                            "@name": "MaxRetries",
                            "@type": "long",
                            "@required": "false",
                            "@trim": "true",
                            "description": "Failed attempts after which a record is no longer retried automatically.",
                            "default-value": "8",
                            "min-value": "1",
                            "max-value": "50"
                        },
                        {
                            "@name": "BaseDelayMinutes",
                            "@type": "long",
                            "@required": "false",
                            "@trim": "true",
                            "description": "Initial retry delay in minutes; doubled after each failed attempt.",
                            "default-value": "5",
                            "min-value": "1",
                            "max-value": "1440"
                        },
                        {
                            "@name": "MaxDelayMinutes",
                            "@type": "long",
                            "@required": "false",
                            "@trim": "true",
                            "description": "Upper bound for the retry delay in minutes.",
                            "default-value": "720",
                            "min-value": "1",
                            "max-value": "10080"
                        },
                        {
                            "@name": "LockTimeoutMinutes",
                            "@type": "long",
                            "@required": "false",
                            "@trim": "true",
                            "description": "Records left in PROCESSING longer than this are treated as failed attempts and retried.",
                            "default-value": "30",
                            "min-value": "5",
                            "max-value": "1440"
                        }
                    ]
                },
                "status-codes": {
                    "status": [
                        {
                            "@code": "ERROR",
                            "description": "Unexpected error or export stopped early (configuration, authentication or availability)."
                        },
                        {
                            "@code": "ABORTED",
                            "description": "Export stopped early because of a configuration, authentication or availability error."
                        },
                        {
                            "@code": "DISABLED",
                            "description": "Seet order sync is disabled or not configured for the site."
                        },
                        {
                            "@code": "OK",
                            "description": "Step finished; the message contains batch statistics."
                        }
                    ]
                }
            }
        ]
    }
}
